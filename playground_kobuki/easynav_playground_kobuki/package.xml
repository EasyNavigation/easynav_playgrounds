<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>easynav_playground_kobuki</name>
  <version>0.5.0</version>
  <description>Easy Navigation playground with a Kobuki: EasyNav configurations and launchers for the Kobuki simulation (costmap with RPP, MPPI, MPC, SeReST, MH-AMCL, routes and safety mode; Simple; mapping; multirobot).</description>
  <maintainer email="fmrico@gmail.com">Francisco Martín Rico</maintainer>
  <license file="LICENSE">Apache-2.0</license>
  <author email="fmrico@gmail.com">Francisco Martín Rico</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>easynav_costmap_localizer</exec_depend>
  <exec_depend>easynav_costmap_maps_manager</exec_depend>
  <exec_depend>easynav_costmap_planner</exec_depend>
  <exec_depend>easynav_diagnostic_recovery</exec_depend>
  <exec_depend>easynav_interfaces</exec_depend>
  <exec_depend>easynav_mhamcl_localizer</exec_depend>
  <exec_depend>easynav_mpc_controller</exec_depend>
  <exec_depend>easynav_mppi_controller</exec_depend>
  <exec_depend>easynav_playground_kobuki_worlds</exec_depend>
  <exec_depend>easynav_regulated_pp_controller</exec_depend>
  <exec_depend>easynav_routes_maps_manager</exec_depend>
  <exec_depend>easynav_serest_controller</exec_depend>
  <exec_depend>easynav_simple_controller</exec_depend>
  <exec_depend>easynav_simple_localizer</exec_depend>
  <exec_depend>easynav_simple_maps_manager</exec_depend>
  <exec_depend>easynav_simple_planner</exec_depend>
  <exec_depend>easynav_simple_recovery</exec_depend>
  <exec_depend>easynav_system</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>launch_yaml</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>ros2topic</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
