<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>easynav_playground_kobuki_worlds</name>
  <version>0.5.0</version>
  <description>Gazebo (Harmonic or newer) simulation of a Kobuki for the EasyNav playgrounds: the AWS small house world, its map, and the launchers that spawn one or several Kobukis with the ROS-Gazebo bridge.</description>
  <maintainer email="fmrico@gmail.com">Francisco Martín Rico</maintainer>
  <!-- Launchers, bridge configuration and maps -->
  <license file="LICENSE">Apache-2.0</license>
  <!-- Small house world and models (worlds/, models/, photos/), from AWS RoboMaker's
       aws-robomaker-small-house-world -->
  <license file="models/LICENSE">MIT-0</license>
  <author email="fmrico@gmail.com">Francisco Martín Rico</author>
  <author>Amazon.com, Inc. or its affiliates (the small house world)</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>easynav_playground_kobuki_description</exec_depend>
  <exec_depend>gz_sim_vendor</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>launch_yaml</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>xacro</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
