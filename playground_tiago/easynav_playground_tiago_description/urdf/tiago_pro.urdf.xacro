          <stddev>0.01</stddev>
        </noise>
      </ray>
    </sensor>
    <material>Gazebo/DarkGrey</material>
  </gazebo>
  <joint name="virtual_base_laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="virtual_base_laser_link"/>
