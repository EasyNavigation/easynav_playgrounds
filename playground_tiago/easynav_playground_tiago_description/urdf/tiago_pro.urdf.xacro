<?xml version="1.0"?>
<!--
  TIAGo Pro (omni_base with two SICK TIM571 lasers, two tiago-pro arms with spherical wrist,
  tool changer and pal-pro-gripper, head camera realsense-d435), for Gazebo (gz sim, from
  Harmonic). Expanded from PAL Robotics' tiago_pro_robot 59593c6, omni_base_robot 49ecf70,
  tiago_pro_head_robot a10e252, pal_sea_arm efe6fab, pal_pro_gripper ed94457 and pal_urdf_utils
  e8600a3 (humble-devel branches, Apache-2.0), and RealSense's realsense2_description
  (realsense-ros 7a87097, Apache-2.0), with PAL's default TIAGo Pro configuration:
    xacro tiago_pro.urdf.xacro gazebo_version:=gazebo is_public_sim:=true use_sim_time:=true
      camera_model:=realsense-d435 laser_model:=sick-571
  Changes from PAL's model:
  - Base driven by ros2_controllers' mecanum_drive_controller (PAL's omni_drive_controller is
    not released), which also reads the wheel velocities; see config/tiago_pro_controllers.yaml.
  - Wheel friction as in gz-sim's mecanum_drive example (mu 1.0 along the rollers' drive
    direction, mu2 0.0 across): with PAL's mu2 0.3, the wheels stalled when strafing.
  - Head camera images in R8G8B8 (gz-sim cameras do not render B8G8R8).
  - Gripper mimic joints taken from the URDF <mimic> tags (ros2_control), without PAL's gripper
    transmission plugin.
  - Arms and torso start in PAL's "home" posture, arms tucked (initial_value in ros2_control).
  Meshes are file:// URIs to this package's meshes/, resolved by xacro (Gazebo and RViz load them);
  the controllers come from config/tiago_pro_controllers.yaml.
-->
<robot name="tiago_pro" xmlns:gz="http://gazebosim.org/schema" xmlns:xacro="http://ros.org/wiki/xacro">
  <link name="sellion_link"/>
  <joint name="sellion_joint" type="fixed">
    <origin rpy="1.5708 0 0" xyz="0.04 -0.09205 0"/>
    <child link="sellion_link"/>
    <parent link="head_2_link"/>
  </joint>
  <link name="eye_right_link"/>
  <joint name="eye_right_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0.0 -0.1 0"/>
    <child link="eye_right_link"/>
    <parent link="sellion_link"/>
  </joint>
  <link name="eye_left_link"/>
  <joint name="eye_left_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0.1 0"/>
    <child link="eye_left_link"/>
    <parent link="sellion_link"/>
  </joint>
  <link name="head_front_camera_color_eye_frame"/>
  <joint name="color_eye_joint" type="fixed">
    <origin rpy="-1.571 0.000 -1.571" xyz="0.000 0.000 0.000"/>
    <child link="head_front_camera_color_eye_frame"/>
    <parent link="head_front_camera_link"/>
  </joint>
  <material name="Blue">
    <color rgba="0.0 0.0 0.8 1.0"/>
  </material>
  <material name="Green">
    <color rgba="0.0 0.8 0.0 1.0"/>
  </material>
  <material name="Grey">
    <color rgba="0.7 0.7 0.7 1.0"/>
  </material>
  <material name="LightGrey">
    <color rgba="0.9 0.9 0.9 1.0"/>
  </material>
  <material name="DarkGrey">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>
  <material name="Red">
    <color rgba="0.8 0.0 0.0 1.0"/>
  </material>
  <material name="White">
    <color rgba="1.0 1.0 1.0 1.0"/>
  </material>
  <material name="Yellow">
    <color rgba="0.96 0.88 0.14 1.0"/>
  </material>
  <material name="Black">
    <color rgba="0.0 0.0 0.0 1.0"/>
  </material>
  <material name="FlatBlack">
    <color rgba="0.09 0.09 0.09 1.0"/>
  </material>
