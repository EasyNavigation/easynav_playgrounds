    <color rgba="0.5 0.5 0.5 1"/>
  </material>
  <material name="plastic">
    <color rgba="0.1 0.1 0.1 1"/>
  </material>
  <link name="base_rear_laser_link" type="laser">
    <inertial>
      <origin rpy="0 0 0" xyz="-0.02559000000 -0.00056000000 -0.05732000000"/>
      <mass value="0.28922000000"/>
      <inertia ixx="0.00002628919" ixy="0.00000024298" ixz="-0.00000368129" iyy="0.00003374542" iyz="-0.00000001330" izz="0.00005832599"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find easynav_playground_tiago_description)/meshes/pal_urdf_utils/laser/sick_tim551.stl"/>
      </geometry>
      <material name="DarkGrey"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.01" radius="0.01"/>
      </geometry>
    </collision>
  </link>
  <joint name="base_rear_laser_joint" type="fixed">
    <axis xyz="0 1 0"/>
    <origin rpy="-3.141592653589793 0 2.356194490192345" xyz="-0.27512 0.18297 0.13244"/>
    <parent link="base_link"/>
    <child link="base_rear_laser_link"/>
  </joint>
  <gazebo reference="base_rear_laser_link">
    <sensor name="base_rear_laser" type="gpu_lidar">
      <update_rate>10</update_rate>
      <topic>scan_rear_raw</topic>
      <gz_frame_id>base_rear_laser_link</gz_frame_id>
      <visualize>true</visualize>
      <always_on>true</always_on>
      <ray>
        <scan>
          <horizontal>
            <samples>818.0</samples>
            <resolution>1</resolution>
            <min_angle>-2.3387411976724017</min_angle>
            <max_angle>2.356194490192345</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.05</min>
          <max>25.0</max>
          <resolution>0.001</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
    </sensor>
    <material>Gazebo/DarkGrey</material>
  </gazebo>
  <link name="base_front_laser_link" type="laser">
    <inertial>
      <origin rpy="0 0 0" xyz="-0.02559000000 -0.00056000000 -0.05732000000"/>
      <mass value="0.28922000000"/>
      <inertia ixx="0.00002628919" ixy="0.00000024298" ixz="-0.00000368129" iyy="0.00003374542" iyz="-0.00000001330" izz="0.00005832599"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find easynav_playground_tiago_description)/meshes/pal_urdf_utils/laser/sick_tim551.stl"/>
      </geometry>
