<?xml version="1.0"?>
<!--
  TIAGo (base pmb2, tiago-arm with wrist-2010, schunk-ft, pal-gripper, laser sick-571, camera
  orbbec-astra), for Gazebo (gz sim, from Harmonic). Expanded from PAL Robotics'
  tiago_description, pmb2_description and pal_gripper_description (Apache-2.0), Gazebo Harmonic
  ports at https://github.com/Tiago-Harmonic (tiago_robot 29211f4, pmb2_robot a9c09d2,
  pal_gripper b6eec0f), with PAL's default TIAGo configuration:
    xacro tiago.urdf.xacro arm_type:=tiago-arm end_effector:=pal-gripper ft_sensor:=schunk-ft
      wrist_model:=wrist-2010 base_type:=pmb2 laser_model:=sick-571 camera_model:=orbbec-astra
      use_sim_time:=true is_public_sim:=true
  Changes from PAL's model:
  - The head camera has a gz_frame_id (its point cloud used Gazebo's scoped sensor name as frame).
  - Wheel velocity commands limited to the wheel joint limit (10.15 rad/s, 1 m/s) instead of
    1 rad/s (0.1 m/s), which made the base crawl.
  - Arm and torso start in PAL's "home" posture, arm tucked (initial_value in ros2_control).
  Meshes are file:// URIs to this package's meshes/, resolved by xacro (Gazebo and RViz load them);
  the controllers come from config/tiago_controllers.yaml.
-->
<robot name="tiago" xmlns:xacro="http://ros.org/wiki/xacro">
  <material name="Blue">
    <color rgba="0.0 0.0 0.8 1.0"/>
  </material>
  <material name="Green">
    <color rgba="0.0 0.8 0.0 1.0"/>
  </material>
  <material name="Grey">
    <color rgba="0.7 0.7 0.7 1.0"/>
  </material>
  <material name="LightGrey">
    <color rgba="0.9 0.9 0.9 1.0"/>
  </material>
  <material name="DarkGrey">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>
  <material name="Red">
    <color rgba="0.8 0.0 0.0 1.0"/>
  </material>
  <material name="White">
    <color rgba="1.0 1.0 1.0 1.0"/>
  </material>
  <material name="Yellow">
    <color rgba="0.96 0.88 0.14 1.0"/>
  </material>
  <material name="Black">
    <color rgba="0.0 0.0 0.0 1.0"/>
  </material>
  <material name="FlatBlack">
    <color rgba="0.09 0.09 0.09 1.0"/>
  </material>
  <material name="Orange">
    <color rgba="1.0 0.487 0.0 1.0"/>
  </material>
  <material name="pal/Orange">
    <color rgba="0.91373 0.61568 0.29411 1.0"/>
  </material>
  <material name="pal/DarkGrey">
    <color rgba="0.29804 0.29804 0.29804 1"/>
  </material>
  <link name="base_imu_link">
    <inertial>
      <mass value="0.01"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.000001" ixy="0" ixz="0" iyy="0.000001" iyz="0" izz="0.000001"/>
    </inertial>
  </link>
  <joint name="base_imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="base_imu_link"/>
    <origin rpy="0 0 -1.5707963267948966" xyz="0.10171 0 0.11282"/>
  </joint>
  <gazebo reference="base_imu_link">
    <sensor name="base_imu_sensor" type="imu">
      <always_on>1</always_on>
      <update_rate>100.0</update_rate>
      <topic>base_imu</topic>
      <imu>
        <noise>
          <type>gaussian</type>
          <rate>
            <mean>0.0</mean>
            <stddev>2e-4</stddev>
            <bias_mean>0.0000075</bias_mean>
            <bias_stddev>0.0000008</bias_stddev>
          </rate>
          <accel>
            <mean>0.0</mean>
            <stddev>1.7e-2</stddev>
            <bias_mean>0.1</bias_mean>
            <bias_stddev>0.001</bias_stddev>
          </accel>
        </noise>
      </imu>
    </sensor>
  </gazebo>
  <link name="base_laser_link">
    <inertial>
      <origin rpy="0 0 0" xyz="-0.02559000000 -0.00056000000 -0.05732000000"/>
      <mass value="0.28922000000"/>
      <inertia ixx="0.00002628919" ixy="0.00000024298" ixz="-0.00000368129" iyy="0.00003374542" iyz="-0.00000001330" izz="0.00005832599"/>
    </inertial>
    <visual>
      <geometry>
        <mesh filename="file://$(find easynav_playground_tiago_description)/meshes/pmb2/sensors/sick_tim551.stl"/>
      </geometry>
      <material name="DarkGrey"/>
    </visual>
  </link>
  <joint name="base_laser_joint" type="fixed">
    <axis xyz="0 1 0"/>
    <origin rpy="0 0 0" xyz="0.252 0.0 -0.004"/>
    <parent link="base_link"/>
    <child link="base_laser_link"/>
  </joint>
  <gazebo reference="base_laser_link">
    <sensor name="sick_tim571" type="gpu_lidar">
      <update_rate>10</update_rate>
      <visualize>true</visualize>
      <always_on>true</always_on>
      <topic>scan_raw</topic>
      <gz_frame_id>base_laser_link</gz_frame_id>
      <lidar>
        <scan>
          <horizontal>
            <samples>666.5185185185185</samples>
            <resolution>1</resolution>
            <min_angle>-1.9198621771937625</min_angle>
            <max_angle>1.9198621771937625</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.05</min>
          <max>25.0</max>
          <resolution>0.001</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>
  <link name="base_sonar_03_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.001"/>
      <inertia ixx="0.000001" ixy="0" ixz="0" iyy="0.000001" iyz="0" izz="0.000001"/>
