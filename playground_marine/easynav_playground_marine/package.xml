<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>easynav_playground_marine</name>
  <version>0.1.0</version>
  <description>Playground for boats and submarines: one launch, with robot:=boat or robot:=submarine, starts the marine simulation (a Gazebo world with a synthetic sea, and the vehicle in it). It carries no navigation system: no EasyNav system of the family works on water yet.</description>
  <maintainer email="josemiguel.guerrero@urjc.es">José Miguel Guerrero</maintainer>
  <license file="LICENSE">Apache-2.0</license>
  <author email="josemiguel.guerrero@urjc.es">José Miguel Guerrero</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>easynav_playground_marine_worlds</exec_depend>
  <exec_depend>easynav_playground_marine_description</exec_depend>
  <exec_depend>launch_yaml</exec_depend>
  <exec_depend>easynav_system</exec_depend>
  <exec_depend>easynav_bonxai_maps_manager</exec_depend>
  <exec_depend>easynav_bonxai_planner</exec_depend>
  <exec_depend>easynav_fusion_localizer</exec_depend>
  <exec_depend>easynav_mpc_controller</exec_depend>
  <exec_depend>navmap_rviz_plugin</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>python3-yaml</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
