<?xml version="1.0"?>
<model>
  <name>nathan_benderson_park</name>
  <version>1.0</version>
  <sdf version="1.6">model.sdf</sdf>
  <author>
    <name>Cole Biesemeyer</name>
    <email>cole@openrobotics.org</email>
  </author>
  <description>
    Nathan Benderson Park (Florida). Copy of the model.sdf of the Fuel model
    "Nathan Benderson Park" (https://fuel.gazebosim.org/1.0/OpenRobotics/models/nathan_benderson_park),
    version 5; meshes and textures are still taken from Fuel. The heightmap collision is
    lowered with a collision pose, because gz-physics ignores the heightmap pos.
  </description>
</model>
