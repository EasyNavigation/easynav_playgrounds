<?xml version="1.0"?>
<robot name="steering_wheel" xmlns:xacro="http://wiki.ros.org/xacro">
  <xacro:macro name="steering_wheel" params="prefix parent *origin">

    <joint name="${prefix}steering_wheel_joint" type="continuous">
      <parent link="${parent}"/>
      <child link="${prefix}steering_wheel_link"/>
      <xacro:insert_block name="origin" />
      <axis xyz="0 0 1" />
      <mimic joint="front_axle_left_joint" multiplier="1" offset="0"/>
    </joint>

    <link name="${prefix}steering_wheel_link">
			<inertial>
		  		<mass value="1.0" />
		  		<origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
		  		<inertia  ixx="0.14583300" ixy="0.0"  ixz="0.0"  iyy="0.14583300"  iyz="0.0"  izz="0.12500000" />
			</inertial>
			<visual>
				<origin xyz="0 0 0" rpy="${PI/2} 0 0" />
				<geometry>
					<mesh filename="file://$(find easynav_playground_ackermann_description)/meshes/steering_wheel.dae"/>
				</geometry>
			</visual>
			<collision>
				<origin xyz="0 0 0" rpy="0 0 0" />
				<geometry>
					<cylinder radius="0.178172" length="0.041845"/>
				</geometry>
			</collision>
    </link>

  </xacro:macro>
</robot>