<?xml version="1.0"?>
<robot name="wheel" xmlns:xacro="http://wiki.ros.org/xacro">

  <xacro:property name="M_PI" value="3.1415926535897931" />

  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertia  ixx="${m*(3*r*r+h*h)/12}" ixy = "0" ixz = "0"
              iyy="${m*r*r/2}" iyz = "0"
              izz="${m*(3*r*r+h*h)/12}" />
  </xacro:macro>

  <xacro:macro name="wheel" params="prefix parent *origin reflect wheel_radius:=0.3 wheel_width:=0.16 wheel_mass:=11">

<!--WHEEL TIRE -->
    <joint name="${prefix}wheel_joint" type="continuous">
      <parent link="${parent}"/>
      <child link="${prefix}wheel_link"/>
      <xacro:insert_block name="origin" />
      <axis xyz="0 0 1" />
    </joint>

    <link name="${prefix}wheel_link">
      <visual>
          <xacro:unless value="${reflect}">
            <origin xyz="0 0 0" rpy="0 0 0" />
          </xacro:unless>
          <xacro:if value="${reflect}">
            <origin xyz="0 0 0" rpy="${M_PI} 0 0" />
          </xacro:if>
          <geometry>
							<mesh filename="file://$(find easynav_playground_ackermann_description)/meshes/wheel.dae"/>	
          </geometry>
      </visual>

      <collision>
          <xacro:unless value="${reflect}">
            <origin xyz="0 0 0" rpy="0 0 0" />
          </xacro:unless>
          <xacro:if value="${reflect}">
            <!-- <origin xyz="0 0 0" rpy="${M_PI/2} 0 0" /> -->
            <origin xyz="0 0 0" rpy="${M_PI} 0 0" />
          </xacro:if>        
          <geometry>
						<cylinder radius="0.3" length="0.16"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="${wheel_mass}" />
        <origin xyz="0 0 0" />
        <xacro:cylinder_inertia  m="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}" />
      </inertial>
    </link>


    <!-- Transmission is important to link the joints and the controller (see summit_xl_control/config/summit_xl_control.yaml)-->
    <transmission name="${prefix}wheel_joint_trans">
      <plugin>transmission_interface/SimpleTransmission</plugin>
      <actuator name="${prefix}wheel_joint_motor" role="${prefix}wheel_joint_motor"/>
      <joint name="${prefix}wheel_joint" role="${prefix}wheel_joint">
        <mechanicalReduction>1</mechanicalReduction>
        <!-- <motorTorqueConstant>20</motorTorqueConstant> -->
      </joint>
     </transmission>
  </xacro:macro>

</robot>