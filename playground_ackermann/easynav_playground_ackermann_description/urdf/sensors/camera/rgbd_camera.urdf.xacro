<!-- Forward RGBD camera: Gazebo publishes <frame_prefix>/image, depth_image, points and
     camera_info -->
<robot name="sensor_rgbd_camera" xmlns:xacro="http://wiki.ros.org/xacro">
  <xacro:macro name="sensor_rgbd_camera"
               params="frame_prefix parent *origin horizontal_fov:=1.4 width:=1280 height:=720
                       update_rate:=15 far:=60.0">

    <joint name="${frame_prefix}_base_joint" type="fixed">
      <xacro:insert_block name="origin"/>
      <parent link="${parent}"/>
      <child link="${frame_prefix}_link"/>
    </joint>
    <link name="${frame_prefix}_link">
      <visual>
        <geometry>
          <box size="0.08 0.25 0.06"/>
        </geometry>
        <material name="camera_black">
          <color rgba="0.1 0.1 0.1 1"/>
        </material>
      </visual>
      <inertial>
        <mass value="0.3"/>
        <inertia ixx="0.0017" ixy="0" ixz="0" iyy="0.0003" iyz="0" izz="0.0017"/>
      </inertial>
    </link>

    <joint name="${frame_prefix}_optical_joint" type="fixed">
      <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
      <parent link="${frame_prefix}_link"/>
      <child link="${frame_prefix}_optical_frame"/>
    </joint>
    <link name="${frame_prefix}_optical_frame"/>

    <gazebo reference="${frame_prefix}_link">
      <sensor name="${frame_prefix}_sensor" type="rgbd_camera">
        <always_on>1</always_on>
        <update_rate>${update_rate}</update_rate>
        <visualize>true</visualize>
        <topic>${frame_prefix}</topic>
        <gz_frame_id>${frame_prefix}_link</gz_frame_id>
        <camera>
          <horizontal_fov>${horizontal_fov}</horizontal_fov>
          <image>
            <width>${width}</width>
            <height>${height}</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>${far}</far>
          </clip>
          <optical_frame_id>${frame_prefix}_optical_frame</optical_frame_id>
        </camera>
      </sensor>
    </gazebo>
  </xacro:macro>
</robot>
