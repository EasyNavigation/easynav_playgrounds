<?xml version="1.0"?>
<robot name="all_sensors" xmlns:xacro="http://wiki.ros.org/xacro">

  <!-- RGBD camera -->
  <xacro:include filename="$(find easynav_playground_ackermann_description)/urdf/sensors/camera/rgbd_camera.urdf.xacro" />

  <!-- 3D Lidars -->
  <xacro:include filename="$(find easynav_playground_ackermann_description)/urdf/sensors/lidar_3d/lidar_3d.urdf.xacro" />

  <!-- 2D Lidars -->
  <xacro:include filename="$(find easynav_playground_ackermann_description)/urdf/sensors/lidar_2d/lidar_2d.urdf.xacro" />

  <!-- IMUs -->
  <xacro:include filename="$(find easynav_playground_ackermann_description)/urdf/sensors/imu/imu.urdf.xacro" />

  <!-- GPS -->
  <xacro:include filename="$(find easynav_playground_ackermann_description)/urdf/sensors/gps/gps.urdf.xacro" />

</robot>