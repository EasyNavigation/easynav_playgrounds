<?xml version="1.0"?>
<robot name="wheel" xmlns:xacro="http://wiki.ros.org/xacro">

  <xacro:property name="M_PI" value="3.1415926535897931" />

  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertia  ixx="${m*(3*r*r+h*h)/12}" ixy = "0" ixz = "0"
              iyy="${m*r*r/2}" iyz = "0"
              izz="${m*(3*r*r+h*h)/12}" />
  </xacro:macro>

  <xacro:macro name="rubber_wheel" params="prefix parent *origin reflect hq rubber_wheel_radius:=0.115 rubber_wheel_width:=0.15 rubber_wheel_mass:=6.5
                mesh_file:=meshes/wheels/rubber_wheel/rubber_wheel_right">

<!--WHEEL TIRE -->
    <joint name="${prefix}wheel_joint" type="continuous">
      <parent link="${parent}"/>
      <child link="${prefix}wheel_link"/>
      <xacro:insert_block name="origin" />
      <axis xyz="0 1 0" />
      <limit effort="100" velocity="100"/>
			<joint_properties damping="0.5" friction="0.5"/>
    </joint>

    <link name="${prefix}wheel_link">
      <visual>
        <!-- HIGH RESOLUTION WHEELS -->
        <xacro:if value="${hq}">
          <xacro:unless value="${reflect}">
            <origin xyz="0 0 0" rpy="0 0 0" />
          </xacro:unless>
          <xacro:if value="${reflect}">
            <origin xyz="0 0 0" rpy="${M_PI} 0 0" />
          </xacro:if>
          <geometry>
							<mesh filename="file://$(find easynav_playground_summit_description)/${mesh_file}.dae" />	
          </geometry>
        </xacro:if>
       <!-- LOW RESOLUTION WHEELS -->
        <xacro:unless value="${hq}">
          <origin xyz="0 0 0" rpy="${M_PI/2} 0 0" />
          <geometry>
            <cylinder length="${rubber_wheel_width}" radius="${rubber_wheel_radius}" />
          </geometry>
        </xacro:unless>
      </visual>

      <collision>
          <!-- Cylinder with the wheel mesh bounds (axis along y): the tread mesh against the
               terrain mesh overflows ODE's trimesh-trimesh contacts -->
          <origin xyz="0 0 0" rpy="${M_PI/2} 0 0" />
          <geometry>
            <cylinder length="0.1424" radius="0.1175" />
        </geometry>
      </collision>
      <inertial>
        <mass value="${rubber_wheel_mass}" />
        <origin xyz="0 0 0" />
        <xacro:cylinder_inertia  m="${rubber_wheel_mass}" r="${rubber_wheel_radius}" h="${rubber_wheel_width}" />
      </inertial>
    </link>

    <!-- Skid steering: low friction along the wheel axis (z of the rotated collision cylinder)
         lets the wheels slide sideways when the robot turns; full grip along the tread -->
    <gazebo reference="${prefix}wheel_link">
      <mu1>0.6</mu1>
      <mu2>1.0</mu2>
      <fdir1>0 0 1</fdir1>
    </gazebo>
    <!-- <gazebo reference="${prefix}wheel_link">
      <mu1>10.6</mu1>
      <mu2>30.6</mu2>
      <kp>1000000.0</kp>
      <kd>1.0</kd>
      <minDepth>0.0001</minDepth>
      <maxVel>10000.0</maxVel>
    </gazebo> -->

    <!-- Transmission is important to link the joints and the controller (see summit_xl_control/config/summit_xl_control.yaml)-->
    <transmission name="${prefix}wheel_joint_trans">
      <plugin>transmission_interface/SimpleTransmission</plugin>
      <actuator name="${prefix}wheel_joint_motor" role="${prefix}wheel_joint_motor"/>
      <joint name="${prefix}wheel_joint" role="${prefix}wheel_joint">
        <mechanicalReduction>1</mechanicalReduction>
        <!-- <motorTorqueConstant>20</motorTorqueConstant> -->
      </joint>
     </transmission>
  </xacro:macro>

</robot>
