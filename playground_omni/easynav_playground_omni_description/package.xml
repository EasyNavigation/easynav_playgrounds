<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>easynav_playground_omni_description</name>
  <version>0.5.0</version>
  <description>Omnidirectional robots (three to six wheels) description for the EasyNav playgrounds: URDF, meshes and ros2_control controllers, from ros2_omni_robot_sim.</description>
  <maintainer email="fmrico@gmail.com">Francisco Martín Rico</maintainer>
  <!-- The robots (urdf/, meshes/) and their controllers (config/): Copyright (c) 2025 Yohan Prakoso,
       from ros2_omni_robot_sim -->
  <license file="LICENSE">MIT</license>
  <author>Yohan Prakoso</author>
  <!-- Adapted for the EasyNav playgrounds (paths to this package) -->
  <author email="fmrico@gmail.com">Francisco Martín Rico</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>xacro</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
