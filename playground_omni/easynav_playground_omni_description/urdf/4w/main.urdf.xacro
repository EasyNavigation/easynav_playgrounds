<robot name="simple_robot" xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:include filename="$(find easynav_playground_omni_description)/urdf/4w/base_link.urdf.xacro" />
  <xacro:include filename="$(find easynav_playground_omni_description)/urdf/4w/gazebo_plugins.urdf.xacro" />   
  <xacro:include filename="$(find easynav_playground_omni_description)/urdf/4w/ros2_control.urdf.xacro" />

  <link name="base_footprint" />
  <!-- Base Link -->
  <!-- <link name="base_link" /> -->
  <xacro:base_link  parent="base_footprint" xyz="0 0 0" rpy="0 0 0" />

  <!-- <xacro:omni_wheel parent="base_link" suffix="1" xyz="0 0 0" rpy="0 0 0"/> -->

</robot>