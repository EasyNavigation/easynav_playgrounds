<robot name="delirobo" xmlns:xacro="http://ros.org/wiki/xacro">

	<xacro:include filename="$(find easynav_playground_omni_description)/urdf/3w/camera/camera.gazebo.xacro" />

	<xacro:macro name="camera_v0" params="prefix parent *joint_origin">
		<joint name="${prefix}_camera_joint" type="fixed">
			<xacro:insert_block name="joint_origin" />
			<parent link="${parent}" />
			<child link="${prefix}_camera_link" />
		</joint>

		<link name="${prefix}_camera_link">
			<visual>
				<geometry>
					<mesh filename="package://easynav_playground_omni_description/meshes/DAE/camera/camera.dae" />
				</geometry>
			</visual>
			<collision>
				<geometry>
					<mesh filename="package://easynav_playground_omni_description/meshes/STL/camera/camera.stl" />
				</geometry>
			</collision>
			<inertial>
				<origin xyz="0 0 0" />
				<mass value="0.1" />
				<inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001" />
			</inertial>
		</link>
	</xacro:macro>

</robot>