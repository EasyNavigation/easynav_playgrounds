<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:include filename="$(find easynav_playground_omni_description)/urdf/3w/camera_bracket/camera_bracket.transmission.xacro"/>
  <xacro:include filename="$(find easynav_playground_omni_description)/urdf/3w/camera_bracket/camera_bracket.gazebo.xacro"/>
  
  <xacro:macro name="camera_bracket_v0" params="prefix parent *joint_origin *joint_axis">
	<joint name="${prefix}_camera_bracket_joint" type="continuous">
	  <xacro:insert_block name="joint_origin"/>
	  <parent link="${parent}"/>
	  <child link="${prefix}_camera_bracket_link"/>
	  <xacro:insert_block name="joint_axis"/>
	</joint>

	<link name="${prefix}_camera_bracket_link">
	  <visual>
		<geometry>
		  <mesh filename="package://easynav_playground_omni_description/meshes/DAE/camera_bracket/camera_bracket.dae"/>
		</geometry>
	  </visual>
	  <collision>
		<geometry>
		  <mesh filename="package://easynav_playground_omni_description/meshes/STL/camera_bracket/camera_bracket.stl"/>
		</geometry>
	  </collision>
	  <inertial>
		<origin xyz="0 0 0"/>
		<mass value="0.01"/>
		<inertia ixx="0.00031" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.00031"/>
	  </inertial>
	</link>
  </xacro:macro>
  
</robot>
